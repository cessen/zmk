#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// layers
#define LAY_def    0  // Default
#define LAY_nav    1
#define LAY_num    2
#define LAY_os     3
#define LAY_hk     4  // Hotkeys
#define LAY_blen1  5  // Blender Layer 1
#define LAY_mag    6  // Magic

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    behaviors {
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };

        //-----------
        // Cessen

//        // Press once for ctrl, twice for alt, thrice for ctrl+alt.
//        ctrl_alt: tap_dance_0 {
//            compatible = "zmk,behavior-tap-dance";
//            label = "CTRL_ALT_TAP_DANCE";
//            #binding-cells = <0>;
//            tapping-term-ms = <350>;
//            bindings = <&kp LCTRL>, <&kp LALT>, <&ctrl_and_alt>;
//        };
//
        // Press once for shift, twice for word caps.
        shft_cw: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS_WORD_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };

        // Press once for symbol/num layer, twice for hotkey layer.
        sym_hk: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "SYM_HOTKEY_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&mo LAY_num>, <&mo LAY_hk>;
        };

        // Press once for nav layer, twice for os layer.
        nav_os: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "NAV_OS_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&mo LAY_nav>, <&mo LAY_os>;
        };

        comma: comma_non_shifting {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp COMMA>;
            mods = <(MOD_LSFT)>;
        };

        dot: dot_non_shifting {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DOT>;
            mods = <(MOD_LSFT)>;
        };

        quote: quote_non_shifting {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp SQT>;
            mods = <(MOD_LSFT)>;
        };

        minus: minus_non_shifting {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp MINUS>;
            mods = <(MOD_LSFT)>;
        };

        slash: slash_non_shifting {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp SLASH>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        lay_def {
            // A modified Engram layout.
            // ----------------------------------------------                                 ---------------------------------------------
            // | Magic |      |      |      |      | SUPER  |                                 | SUPER  |      |      |      |      |      |
            // ----------------------------------------------                                 ---------------------------------------------
            // | TAB   | Z    | Y    | O    | U    | /      |                                 | ,      | L    | D    | W    | Q    | TAB  |
            // ----------------------------------------------                                 ---------------------------------------------
            // | ESC   | C    | I    | E    | A    | '      |                                 | B      | H    | T    | S    | N    | V    |
            // ----------------------------------------------                                 ---------------------------------------------
            // | TAB   | G    | X    | J    | K    | _      |                                 | .      | R    | M    | F    | P    | DEL  |
            // ------------------------------------------------------------    ------------------------------------------------------------
            //                | SHFT | CTRL | ALT  | SYM/HK | SHIFT | RET |    | BSPC | SPACE | NAV/OS | ALT  | CTRL | SHFT |
            //                ---------------------------------------------    ----------------------------------------------
            bindings = <
            &magic LAY_mag 0   &none   &none       &none       &none      &kp LGUI                                                 &kp LGUI   &none      &none       &none       &none   &none
            &kp TAB            &kp Z   &kp Y       &kp O       &kp U      &slash                                                   &comma     &kp L      &kp D       &kp W       &kp Q   &kp TAB
            &kp ESC            &kp C   &kp I       &kp E       &kp A      &quote                                                   &kp B      &kp H      &kp T       &kp S       &kp N   &kp V
            &kp TAB            &kp G   &kp X       &kp J       &kp K      &kp UNDER                                                &dot       &kp R      &kp M       &kp F       &kp P   &kp DEL
                                       &kp LSHFT   &kp LCTRL   &kp LALT                                                                       &kp RALT   &kp RCTRL   &kp RSHFT
                                                                          &sym_hk   &kp LSHFT   &kp RET     &kp BSPC   &kp SPACE   &nav_os
            >;
        };

        lay_nav {
            // Navigation and left symbols.
            // -----------------------------------------------                                    -----------------------------------------------
            // |     | trans | trans | trans | trans | trans |                                    | trans | trans | trans | trans | trans |     |
            // -----------------------------------------------                                    -----------------------------------------------
            // |     |       |   *   |   /   |   ^   |   %   |                                    | PgUp  | Home  |   ↑   |  End  |       |     |
            // -----------------------------------------------                                    -----------------------------------------------
            // |     |   :   |   +   |   -   |   =   |   &   |                                    | PgDN  |   ←   |   ↓   |   →   |       |     |
            // -----------------------------------------------                                    -----------------------------------------------
            // |     |   ~   |   |   |   <   |   >   |   `   |                                    |       |       |       |       |       |     |
            // ---------------------------------------------------------------    ---------------------------------------------------------------
            //               | trans | trans | trans | trans | trans | trans |    | trans | trans | trans | trans | trans | trans |
            //               -------------------------------------------------    -------------------------------------------------
            bindings = <
            &none   &trans      &trans      &trans   &trans      &trans                                         &trans      &trans     &trans     &trans      &trans   &none
            &none   &none       &kp ASTRK   &slash   &kp CARET   &kp PRCNT                                      &kp PG_UP   &kp HOME   &kp UP     &kp END     &none    &none
            &none   &kp COLON   &kp PLUS    &minus   &kp EQUAL   &kp AMPS                                       &kp PG_DN   &kp LEFT   &kp DOWN   &kp RIGHT   &none    &none
            &none   &kp TILDE   &kp PIPE    &kp LT   &kp GT      &kp GRAVE                                      &none       &none      &none      &none       &none    &none
                                &trans      &trans   &trans                                                                 &trans     &trans     &trans
                                                                 &trans   &trans   &trans     &trans   &trans   &trans
            >;
        };

        lay_num {
            // Numbers and right symbols.
            // -----------------------------------------------                                    -----------------------------------------------
            // |     | trans | trans | trans | trans | trans |                                    | trans | trans | trans | trans | trans |     |
            // -----------------------------------------------                                    -----------------------------------------------
            // |     |       |   5   |   4   |   3   |       |                                    |   $   |   #   |   [   |   ]   |       |     |
            // -----------------------------------------------                                    -----------------------------------------------
            // |     |   .   |   2   |   1   |   0   |   9   |                                    |   !   |   "   |   (   |   )   |   ;   |     |
            // -----------------------------------------------                                    -----------------------------------------------
            // |     |   -   |   8   |   7   |   6   |       |                                    |   ?   |   @   |   {   |   }   |   \   |     |
            // ---------------------------------------------------------------    -------------------------------------------------
            //               | trans | trans | trans | trans | trans | trans |    | trans | trans | trans | trans | trans | trans |
            //               -------------------------------------------------    -------------------------------------------------
            bindings = <
            &none   &trans    &trans   &trans   &trans   &trans                                         &trans      &trans     &trans     &trans     &trans     &none
            &none   &none     &kp N5   &kp N4   &kp N3   &none                                          &kp DLLR    &kp HASH   &kp LBKT   &kp RBKT   &none      &none
            &none   &kp DOT   &kp N2   &kp N1   &kp N0   &kp N9                                         &kp EXCL    &kp DQT    &kp LPAR   &kp RPAR   &kp SEMI   &none
            &none   &minus    &kp N8   &kp N7   &kp N6   &none                                          &kp QMARK   &kp AT     &kp LBRC   &kp RBRC   &kp BSLH   &none
                              &trans   &trans   &trans                                                              &trans     &trans     &trans
                                                         &trans   &trans   &trans     &trans   &trans   &trans
            >;
        };

        lay_os {
            // OS keys.
            // --------------------------------------------------                                    -------------------------------------------------
            // |        | trans | trans | trans | trans | trans |                                    | trans | trans | trans | trans | trans |       |
            // --------------------------------------------------                                    -------------------------------------------------
            // |        |       |       |       |       |       |                                    | W Up  |  W L  | D Up  |  W R  |       |       |
            // --------------------------------------------------                                    -------------------------------------------------
            // | Shtdwn |       |       | File  |  Run  | Term  |                                    | W Dn  |  D L  | D Dn  |  D R  |       | Close |
            // --------------------------------------------------                                    -------------------------------------------------
            // |   F1   |  F2   |  F3   |  F4   |  F5   |  F6   |                                    |  F12  |  F11  |  F10  |  F9   |  F8   |  F7   |
            // ------------------------------------------------------------------    -----------------------------------------------------------------
            //                  | trans | trans | trans | trans | trans | trans |    | trans | trans | trans | trans | trans | trans |
            //                  -------------------------------------------------    -------------------------------------------------
            bindings = <
            &none         &trans   &trans   &trans      &trans      &trans                                         &trans             &trans             &trans         &trans              &trans   &none
            &none         &none    &none    &none       &none       &none                                          &kp LS(LG(UP))     &kp LS(LG(LEFT))   &kp LG(UP)     &kp LS(LG(RIGHT))   &none    &none
            &kp LG(ESC)   &none    &none    &kp LG(E)   &kp LG(R)   &kp LG(T)                                      &kp LS(LG(DOWN))   &kp LG(LEFT)       &kp LG(DOWN)   &kp LG(RIGHT)       &none    &kp LG(BSPC)
            &kp F1        &kp F2   &kp F3   &kp F4      &kp F5      &kp F6                                         &kp F12            &kp F11            &kp F10        &kp F9              &kp F8   &kp F7
                                   &trans   &trans      &trans                                                                        &trans             &trans         &trans
                                                                    &trans   &trans   &trans     &trans   &trans   &trans
            >;
        };

        lay_hk {
            // Hotkeys.
            // -------------------------------------------------------------                                    -----------------------------------------------
            // |     | trans | trans  |    trans    |    trans    | trans  |                                    | trans | trans | trans | trans | trans |     |
            // -------------------------------------------------------------                                    -----------------------------------------------
            // |     |       |        | Shft-Ctrl-C | Shft-Ctrl-V |        |                                    |       |       |       |       |       |     |
            // -------------------------------------------------------------                                    -----------------------------------------------
            // |     |       | Ctrl-X |   Ctrl-C    |   Ctrl-V    | Ctrl-Z |                                    |       |       |       |       |       |     |
            // -------------------------------------------------------------                                    -----------------------------------------------
            // |     |       |        |             |             |        |                                    |       |       |       |       |       |     |
            // -----------------------------------------------------------------------------    -------------------------------------------------
            //               | trans  |    trans    |    trans    | trans  | trans | trans |    | trans | trans | trans | trans | trans | trans |
            //               ---------------------------------------------------------------    -------------------------------------------------
            bindings = <
            &none   &trans   &trans      &trans          &trans          &trans                                         &trans   &trans   &trans   &trans   &trans   &none
            &none   &none    &none       &kp LS(LC(C))   &kp LS(LC(V))   &none                                          &none    &none    &none    &none    &none    &none
            &none   &none    &kp LC(X)   &kp LC(C)       &kp LC(V)       &kp LC(Z)                                      &none    &none    &none    &none    &none    &none
            &none   &none    &none       &none           &none           &none                                          &none    &none    &none    &none    &none    &none
                             &trans      &trans          &trans                                                                  &trans   &trans   &trans
                                                                         &trans   &trans   &trans     &trans   &trans   &trans
            >;
        };

        //======================================================

        lay_blen1 {
            // A layout specifically for using Blender.
            // ----------------------------------------------                                  ---------------------------------------------
            // | Magic |      |      |      |      |        |                                  |        |      |      |      |      |      |
            // ----------------------------------------------                                  ---------------------------------------------
            // |       |      |      |      |      |        |                                  | ,      | L    | D    | W    | Q    | TAB  |
            // ----------------------------------------------                                  ---------------------------------------------
            // |  ESC  | TAB  |  S   |  R   |  G   |  RET   |                                  | B      | H    | T    | S    | N    | V    |
            // ----------------------------------------------                                  ---------------------------------------------
            // |       | ALT  |  X   |  Y   |  Z   |        |                                  | .      | R    | M    | F    | P    | DEL  |
            // -------------------------------------------------------------    ------------------------------------------------------------
            //                |      |      |      | SYM/HK | SHIFT | CTRL |    | BSPC | SPACE | NAV/OS |      |      |      |
            //                ----------------------------------------------    ----------------------------------------------
            bindings = <
            &magic LAY_mag 0   &none   &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI                                                 &kp LGUI   &kp RALT   &kp RCTRL   &kp RSHFT   &none   &none
            &kp TAB            &kp Z   &kp Y       &kp O       &kp U      &slash                                                   &comma     &kp L      &kp D       &kp W       &kp Q   &kp TAB
            &kp ESC            &kp C   &kp I       &kp E       &kp A      &quote                                                   &kp B      &kp H      &kp T       &kp S       &kp N   &kp V
            &kp TAB            &kp G   &kp X       &kp J       &kp K      &kp UNDER                                                &dot       &kp R      &kp M       &kp F       &kp P   &kp DEL
                                       &none       &none       &none                                                                          &none      &none       &none
                                                                          &sym_hk   &kp LSHFT   &kp RET     &kp BSPC   &kp SPACE   &nav_os
            >;
        };

        //======================================================

        lay_mag {
            bindings = <
            &bt BT_CLR    &kp C_BRI_DN      &kp C_BRI_UP      &kp C_PREV        &kp C_NEXT        &kp C_PP                                  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP   &none   &none    &bt BT_CLR_ALL
            &bootloader   &rgb_ug RGB_SPI   &rgb_ug RGB_SAI   &rgb_ug RGB_HUI   &rgb_ug RGB_BRI   &rgb_ug RGB_TOG                           &none       &none         &none          &none   &none    &bootloader
            &sys_reset    &rgb_ug RGB_SPD   &rgb_ug RGB_SAD   &rgb_ug RGB_HUD   &rgb_ug RGB_BRD   &rgb_ug RGB_EFF                           &none       &none         &none          &none   &none    &sys_reset
            &none         &none             &bt_0             &bt_1             &bt_2             &bt_3                                     &none       &none         &none          &none   &none    &none
                                            &out OUT_USB      &none             &none                                                                   &none         &none          &none
                                                                                                  &none   &none   &none     &none   &none   &none
            >;
        };

    };
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 3 1>;
    layer_2 {
        layers = <2>;
        input-processors = <&zip_xy_scaler 9 1>;
    };
};

&cirque_lh_listener {
    input-processors = <&zip_xy_to_scroll_mapper>, <&zip_xy_scaler 1 8>, <&zip_click_to_right_click_mapper>;
    layer_4 {
        layers = <4>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};
